{
  "manifest_version": 3,
  "name": "Instagram Downloader",
  "version": "0.0.1",
  "description": "Download Instagram photos, reels and videos with the post datetime in the filename.",
  "permissions": ["downloads", "webRequest", "cookies", "storage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "css": ["src/content.css"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Instagram Downloader"
  }
}
