{
  "name": "instagram-downloader",
  "version": "0.0.1",
  "license": "GPL-3.0-only",
  "author": "Kevin Van Den Haute",
  "description": "Chrome extension to download images and videos from Instagram",
  "keywords": [
    "Instagram"
  ],
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint src --fix",
    "evergreen": "ncu -i -c 3d --format group",
    "postevergreen": "npm i",
    "evergreen:minor": "ncu --target minor -c 3d -u",
    "evergreen:patch": "ncu --target patch -c 3d -u"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.0",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/chrome": "0.2.0",
    "eslint": "10.6.0",
    "npm-check-updates": "22.2.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vite": "8.1.0"
  },
  "dependencies": {
    "p-map": "7.0.5"
  }
}
